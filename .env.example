# ================= SAQIB-MD Premium WhatsApp Bot =================
# Copy this file to .env and fill in your values.

# ---- Identity ----
BOT_NAME=SAQIB-MD
PREFIX=.
OWNER_NAME=Saqib
# Owner WhatsApp number with country code, digits only (e.g. 923001234567)
OWNER_NUMBER=923001234567

# ---- AI (Google Gemini) ----
# Get a free key: https://aistudio.google.com/app/apikey
# NOTE: gemini-2.x models are blocked for new keys — use gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Behaviour ----
MODE=public
AUTO_READ=true
AUTO_TYPING=true
WELCOME=true
GOODBYE=true
ANTILINK=false
TIMEZONE=Asia/Karachi
PORT=3000

# ---- Session ----
SESSION_DIR=./session
# Optional: base64 encoded session (for restoring a session on redeploy)
SESSION_ID=

# ---- Extra owners (comma separated numbers) ----
SUDO=
