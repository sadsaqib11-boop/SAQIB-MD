# ================= SAQIB-MD Premium WhatsApp Bot =================
# Copy this file to .env and fill in your values.
# NOTE: every auto/anti feature defaults to OFF. Turn them ON live with
# a toggle command (e.g. .antidelete, .autoreact) — the choice is saved.

# ---- Identity ----
BOT_NAME=SAQIB-MD
PREFIX=.
OWNER_NAME=Saqib
# Owner WhatsApp number with country code, digits only (e.g. 923001234567).
# Default owner number for SAQIB-MD:
OWNER_NUMBER=923106762478

# ---- AI (Google Gemini) ----
# Get a free key: https://aistudio.google.com/app/apikey
# NOTE: gemini-2.x models are blocked for new keys — use gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Behaviour (ALL OFF BY DEFAULT) ----
# public = everyone can use commands | private = only the owner can
MODE=public
AUTO_READ=false
AUTO_TYPING=false
AUTO_REACT=false
WELCOME=false
GOODBYE=false
ANTILINK=false
ANTIDELETE=false
# anti-delete also for inbox / DM chats
ANTIDELETE_INBOX=false
ANTISPAM=false
ANTICALL=false
AUTOSTATUS=false
# auto-save a status when someone replies to it (sends it to the owner)
AUTOSAVESTATUS=true
AUTOVIEWONCE=false
AUTOBIO=false
CHATBOT=false
AUTOREAD_STATUS=false
RECORDING=false
STATUSVIEW=false
ADMINISTRATION=false
MENTION_REPLY=false
# show "online" presence (default ON)
ONLINE=false

TIMEZONE=Asia/Karachi
PORT=3000

# ---- Session / multi-session ----
SESSION_DIR=./session
# Optional: base64 encoded session (for restoring a session on redeploy)
SESSION_ID=
# How many WhatsApp numbers can be linked at once (default 50)
MAX_SESSIONS=50

# ---- Extra owners (comma separated numbers) ----
SUDO=
