# ================= SAQIB-MD Premium WhatsApp Bot =================
# Copy this file to .env and fill in your values.
# NOTE: every auto/anti feature defaults to OFF, EXCEPT the two that keep the
# bot healthy: ONLINE (stay online 24/7) and AUTOVIEWONCE (auto-save view-once).
# Turn any other feature ON live with a toggle command (e.g. .antidelete,
# .autoreact) — the choice is saved.

# ---- Identity ----
BOT_NAME=SAQIB-MD
PREFIX=.
OWNER_NAME=Saqib
# Owner WhatsApp number with country code, digits only (e.g. 923001234567).
# Default owner number for SAQIB-MD:
OWNER_NUMBER=923106762478

# ---- AI (Google Gemini) ----
# Get a free key: https://aistudio.google.com/app/apikey
# NOTE: gemini-2.x models are blocked for new keys — use gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Behaviour (OFF BY DEFAULT, except ONLINE + AUTOVIEWONCE) ----
# public = everyone can use commands | private = only the owner can
MODE=public
AUTO_READ=false
AUTO_TYPING=false
AUTO_REACT=false
WELCOME=false
GOODBYE=false
ANTILINK=false
# ignore @-mentions of the bot (nobody can ping the bot)
ANTIMENTION=false
ANTIDELETE=false
# anti-delete also for inbox / DM chats
ANTIDELETE_INBOX=false
ANTISPAM=false
ANTICALL=false
AUTOSTATUS=false
# auto-save a status when someone replies to it (sends it to the owner's inbox)
AUTOSAVESTATUS=true
# auto-save any view-once media to the bot's own chat (default ON)
AUTOVIEWONCE=true
AUTOBIO=false
CHATBOT=false
AUTOREAD_STATUS=false
RECORDING=false
STATUSVIEW=false
ADMINISTRATION=false
MENTION_REPLY=false
# show "online" presence (default ON — keeps the bot online 24/7)
ONLINE=true

# ---- Speed & appearance ----
# FAST_MODE keeps every command reply well under a second (default ON).
FAST_MODE=true
# Bot-wide DEFAULT menu design 1-10. Every user can override it for themselves
# with `.menustyle <1-10>`; the owner changes this default with
# `.menustyle default <1-10>`. Default 1.
MENU_STYLE=1
# Default text font for the bot's own name in the menu: mono | sans | serif ...
DEFAULT_FONT=mono

TIMEZONE=Asia/Karachi
PORT=3000

# ---- Session / multi-session ----
SESSION_DIR=./session
# Optional: base64 encoded session (for restoring a session on redeploy)
SESSION_ID=
# How many WhatsApp numbers can be linked at once (default 500)
MAX_SESSIONS=500

# ---- Extra owners (comma separated numbers) ----
SUDO=
